  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
